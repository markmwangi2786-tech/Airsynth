#include <WiFi.h>
#include <esp_now.h>

#define EXT_LED_PIN 4 // Pin connected to your external LED/Relay

typedef struct struct_message {
    bool toggleCommand;
} struct_message;

struct_message incomingData;

void OnDataRecv(const uint8_t *mac, const uint8_t *incomingDataBytes, int len) {
  memcpy(&incomingData, incomingDataBytes, sizeof(incomingData));
  Serial.printf("Received command: External Light is %s\n", incomingData.toggleCommand ? "ON" : "OFF");
  
  // Update external light state
  digitalWrite(EXT_LED_PIN, incomingData.toggleCommand ? HIGH : LOW);
}

void setup() {
  Serial.begin(115200);
  pinMode(EXT_LED_PIN, OUTPUT);
  digitalWrite(EXT_LED_PIN, LOW);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  esp_now_register_recv_cb(esp_now_recv_cb_t(OnDataRecv));
  Serial.println("AirSynth Receiver Ready!");
}

void loop() {
  // Receiver passively listens for broadcasted gestures
}