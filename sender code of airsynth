#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <FastLED.h>
#include <WiFi.h>
#include <esp_now.h>

// --- Hardware Definitions ---
#define LED_PIN     33
#define NUM_LEDS    12
#define BRIGHTNESS  128
#define LED_TYPE    WS2812B
#define COLOR_ORDER GRB

#define SDA_PIN     8
#define SCL_PIN     9

// --- REPLACE WITH YOUR RECEIVER'S MAC ADDRESS ---
uint8_t receiverAddress[] = {0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF};

// Structure to send gesture data
typedef struct struct_message {
    bool toggleCommand;
} struct_message;

struct_message myData;
esp_now_peer_info_t peerInfo;

Adafruit_MPU6050 mpu;
CRGB leds[NUM_LEDS];

bool externalLightState = false;
unsigned long lastToggleTime = 0;
const int toggleCooldown = 500;

void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  Serial.print("Packet Send Status: ");
  Serial.println(status == ESP_NOW_SEND_SUCCESS ? "Success" : "Fail");
}

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  // Set Wi-Fi to Station mode for ESP-NOW
  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  esp_now_register_send_cb(OnDataSent);

  // Register peer receiver
  memcpy(peerInfo.peer_addr, receiverAddress, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_ERR_ESPNOW_EXIST) {
    // Peer added successfully
  }

  Wire.begin(SDA_PIN, SCL_PIN);
  if (!mpu.begin()) {
    Serial.println("Failed to find MPU6050 chip!");
    while (1) { delay(10); }
  }
  mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

  FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  FastLED.setBrightness(BRIGHTNESS);
  Serial.println("AirSynth Sender Ready!");
}

void loop() {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  // Map Y-axis movement to LED hue
  byte hue = constrain(map((int)(a.acceleration.y * 10), -20, 20, 0, 255), 0, 255);
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = CHSV(hue + (i * 5), 255, constrain(abs(g.gyro.z) * 20, 30, 255));
  }
  FastLED.show();

  // Gesture Trigger: Sharp twist on Z-axis toggles state
  if (abs(g.gyro.z) > 2.0 && (millis() - lastToggleTime > toggleCooldown)) {
    externalLightState = !externalLightState;
    
    myData.toggleCommand = externalLightState;
    esp_now_send(receiverAddress, (uint8_t *) &myData, sizeof(myData));

    // Flash wearable LEDs green (ON) or red (OFF)
    fill_solid(leds, NUM_LEDS, externalLightState ? CRGB::Green : CRGB::Red);
    FastLED.show();
    delay(150);

    lastToggleTime = millis();
  }

  delay(20);
}